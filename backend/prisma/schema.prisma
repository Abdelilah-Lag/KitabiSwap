generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model book_images {
  id              BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  book_catalog_id BigInt                   @db.UnsignedBigInt
  image_url       String                   @db.VarChar(500)
  public_id       String                   @db.VarChar(255)
  uploaded_by     BigInt?                  @db.UnsignedBigInt
  image_source    book_images_image_source @default(user_submission)
  is_cover        Boolean?                 @default(false)
  sort_order      Int?                     @default(1)
  created_at      DateTime                 @default(now()) @db.Timestamp(0)
  books_catalog   books_catalog            @relation(fields: [book_catalog_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_book_images_catalog")

  @@index([book_catalog_id], map: "fk_book_images_catalog")
}

model book_submission_images {
  id                 BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  book_submission_id BigInt           @db.UnsignedBigInt
  image_url          String           @db.VarChar(500)
  public_id          String?          @db.VarChar(255)
  is_cover           Boolean          @default(false)
  sort_order         Int              @default(1) @db.UnsignedInt
  created_at         DateTime         @default(now()) @db.Timestamp(0)
  book_submissions   book_submissions @relation(fields: [book_submission_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_book_submission_images_submission")

  @@index([book_submission_id], map: "fk_book_submission_images_submission")
}

model books_catalog {
  id                 BigInt                         @id @default(autoincrement()) @db.UnsignedBigInt
  uuid               String                         @unique(map: "uuid") @db.Char(36)
  isbn               String?                        @unique(map: "isbn") @db.VarChar(20)
  title              String                         @db.VarChar(255)
  subtitle           String?                        @db.VarChar(255)
  author             String                         @db.VarChar(255)
  publisher          String?                        @db.VarChar(255)
  edition            String?                        @db.VarChar(100)
  publication_year   Int?                           @db.Year
  language           String?                        @default("Français") @db.VarChar(100)
  category           String?                        @db.VarChar(100)
  book_type          books_catalog_book_type?       @default(other)
  cover_type         books_catalog_cover_type?      @default(paperback)
  target_audience    books_catalog_target_audience? @default(all)
  pages              Int?                           @db.UnsignedSmallInt
  pages_color        books_catalog_pages_color?     @default(black_white)
  dimensions         String?                        @db.VarChar(100)
  weight             Decimal?                       @db.Decimal(8, 2)
  description        String?                        @db.Text
  summary            String?                        @db.Text
  average_rating     Decimal?                       @default(0.00) @db.Decimal(3, 2)
  total_reviews      Int?                           @default(0) @db.UnsignedInt
  total_views        Int?                           @default(0) @db.UnsignedInt
  search_keywords    String?                        @db.Text
  is_active          Boolean?                       @default(true)
  created_at         DateTime                       @default(now()) @db.Timestamp(0)
  updated_at         DateTime                       @default(now()) @db.Timestamp(0)
  book_images        book_images[]
  book_submissions   book_submissions[]
  shop_inventory     shop_inventory[]
  user_books         user_books[]
  user_books_to_sell user_books_to_sell[]
}

model exchange_chat {
  id                   BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  exchange_request_id  BigInt            @db.UnsignedBigInt
  sender_id            BigInt            @db.UnsignedBigInt
  message              String?           @db.Text
  attachment_url       String?           @db.VarChar(500)
  attachment_public_id String?           @db.VarChar(255)
  is_read              Boolean?          @default(false)
  created_at           DateTime          @default(now()) @db.Timestamp(0)
  exchange_requests    exchange_requests @relation(fields: [exchange_request_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_exchange_chat")
  users                users             @relation(fields: [sender_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_exchange_sender")

  @@index([exchange_request_id], map: "fk_exchange_chat")
  @@index([sender_id], map: "fk_exchange_sender")
}

model exchange_delivery {
  id                       BigInt                                      @id @default(autoincrement()) @db.UnsignedBigInt
  exchange_request_id      BigInt                                      @db.UnsignedBigInt
  delivery_fee             Decimal                                     @db.Decimal(10, 2)
  requester_share          Decimal                                     @db.Decimal(10, 2)
  receiver_share           Decimal                                     @db.Decimal(10, 2)
  requester_payment_method exchange_delivery_requester_payment_method?
  receiver_payment_method  exchange_delivery_receiver_payment_method?
  requester_paid           exchange_delivery_requester_paid?           @default(non)
  receiver_paid            exchange_delivery_receiver_paid?            @default(non)
  delivery_person_id       BigInt?                                     @db.UnsignedBigInt
  status                   exchange_delivery_status?                   @default(pending)
  notes                    String?                                     @db.Text
  created_at               DateTime                                    @default(now()) @db.Timestamp(0)
  updated_at               DateTime                                    @default(now()) @db.Timestamp(0)
  deliveries               deliveries[]
  exchange_requests        exchange_requests                           @relation(fields: [exchange_request_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_exchange_delivery")
  users                    users?                                      @relation(fields: [delivery_person_id], references: [id], onUpdate: Restrict, map: "fk_exchange_delivery_delivery_person")

  @@index([exchange_request_id], map: "fk_delivery_exchange")
  @@index([delivery_person_id], map: "fk_delivery_person")
}

model exchange_requests {
  id                                          BigInt                             @id @default(autoincrement()) @db.UnsignedBigInt
  uuid                                        String                             @unique(map: "uuid") @db.Char(36)
  requester_id                                BigInt                             @db.UnsignedBigInt
  receiver_id                                 BigInt                             @db.UnsignedBigInt
  requester_books                             String                             @db.LongText
  receiver_books                              String                             @db.LongText
  requester_message                           String?                            @db.Text
  status                                      exchange_requests_status?          @default(pending)
  delivery_method                             exchange_requests_delivery_method?
  requester_fee_paid                          Boolean?                           @default(false)
  receiver_fee_paid                           Boolean?                           @default(false)
  requester_confirmed                         Boolean?                           @default(false)
  receiver_confirmed                          Boolean?                           @default(false)
  completed_at                                DateTime?                          @db.Timestamp(0)
  created_at                                  DateTime                           @default(now()) @db.Timestamp(0)
  updated_at                                  DateTime                           @default(now()) @db.Timestamp(0)
  expires_at                                  DateTime                           @default(dbgenerated("(current_timestamp() + interval 10 day)")) @db.Timestamp(0)
  exchange_chat                               exchange_chat[]
  exchange_delivery                           exchange_delivery[]
  users_exchange_requests_receiver_idTousers  users                              @relation("exchange_requests_receiver_idTousers", fields: [receiver_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_exchange_receiver")
  users_exchange_requests_requester_idTousers users                              @relation("exchange_requests_requester_idTousers", fields: [requester_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_exchange_requester")

  @@index([receiver_id], map: "fk_exchange_receiver")
  @@index([requester_id], map: "fk_exchange_requester")
}

model payment_methods {
  id                Int                  @id @default(autoincrement()) @db.UnsignedInt
  name              String               @db.VarChar(100)
  type              payment_methods_type
  account_name      String?              @db.VarChar(150)
  bank_name         String?              @db.VarChar(150)
  rib               String?              @db.VarChar(50)
  iban              String?              @db.VarChar(50)
  swift_code        String?              @db.VarChar(20)
  account_number    String?              @db.VarChar(50)
  payment_url       String?              @db.VarChar(500)
  qr_code_image_url String?              @db.VarChar(500)
  qr_code_public_id String?              @db.VarChar(255)
  instructions      String?              @db.Text
  is_active         Boolean?             @default(true)
  display_order     Int?                 @default(1)
  created_at        DateTime             @default(now()) @db.Timestamp(0)
  updated_at        DateTime             @default(now()) @db.Timestamp(0)
}

model roles {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  name        String   @unique(map: "name") @db.VarChar(50)
  description String?  @db.VarChar(255)
  created_at  DateTime @default(now()) @db.Timestamp(0)
  users       users[]
}

model shop_inventory {
  id              BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  book_catalog_id BigInt                 @db.UnsignedBigInt
  selling_price   Decimal                @db.Decimal(10, 2)
  old_price       Decimal?               @db.Decimal(10, 2)
  stock_quantity  Int?                   @default(0) @db.UnsignedInt
  min_stock_alert Int?                   @default(5) @db.UnsignedInt
  status          shop_inventory_status? @default(available)
  featured        Boolean?               @default(false)
  created_at      DateTime               @default(now()) @db.Timestamp(0)
  updated_at      DateTime               @default(now()) @db.Timestamp(0)
  book_orders     book_orders[]
  favorites       favorites[]
  books_catalog   books_catalog          @relation(fields: [book_catalog_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_shop_catalog")
  user_achat      user_achat[]

  @@index([book_catalog_id], map: "fk_shop_catalog")
}

model user_addresses {
  id              BigInt                          @id @default(autoincrement()) @db.UnsignedBigInt
  uuid            String                          @unique(map: "uuid") @db.Char(36)
  user_id         BigInt                          @db.UnsignedBigInt
  label           String?                         @default("Maison") @db.VarChar(100)
  recipient_name  String                          @db.VarChar(255)
  phone           String                          @db.VarChar(20)
  country         String?                         @default("Maroc") @db.VarChar(100)
  region          String?                         @db.VarChar(100)
  city            String                          @db.VarChar(100)
  district        String?                         @db.VarChar(150)
  street          String?                         @db.VarChar(255)
  building        String?                         @db.VarChar(100)
  apartment       String?                         @db.VarChar(100)
  postal_code     String?                         @db.VarChar(20)
  latitude        Decimal?                        @db.Decimal(10, 8)
  longitude       Decimal?                        @db.Decimal(11, 8)
  location_source user_addresses_location_source? @default(manual)
  is_default      Boolean?                        @default(true)
  is_active       Boolean?                        @default(true)
  created_at      DateTime                        @default(now()) @db.Timestamp(0)
  updated_at      DateTime                        @default(now()) @db.Timestamp(0)
  users           users                           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_user_address_user")

  @@index([user_id], map: "fk_user_address_user")
}

model user_books {
  id              BigInt                     @id @default(autoincrement()) @db.UnsignedBigInt
  user_id         BigInt                     @db.UnsignedBigInt
  book_catalog_id BigInt                     @db.UnsignedBigInt
  book_condition  user_books_book_condition? @default(good)
  estimated_price Decimal?                   @db.Decimal(10, 2)
  exchange_count  Int?                       @default(0) @db.UnsignedInt
  status          user_books_status?         @default(available)
  is_visible      Boolean?                   @default(true)
  note            String?                    @db.Text
  created_at      DateTime                   @default(now()) @db.Timestamp(0)
  updated_at      DateTime                   @default(now()) @db.Timestamp(0)
  favorites       favorites[]
  books_catalog   books_catalog              @relation(fields: [book_catalog_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_user_books_catalog")
  users           users                      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_user_books_user")

  @@index([book_catalog_id], map: "fk_user_books_catalog")
  @@index([user_id], map: "fk_user_books_user")
}

model users {
  id                                                      BigInt                     @id @default(autoincrement()) @db.UnsignedBigInt
  uuid                                                    String                     @unique(map: "uuid") @db.Char(36)
  first_name                                              String                     @db.VarChar(100)
  last_name                                               String                     @db.VarChar(100)
  email                                                   String                     @unique(map: "email") @db.VarChar(255)
  phone                                                   String?                    @unique(map: "phone") @db.VarChar(20)
  password_hash                                           String                     @db.VarChar(255)
  role_id                                                 Int                        @default(2) @db.UnsignedInt
  status                                                  users_status?              @default(pending)
  email_verified                                          Boolean?                   @default(false)
  phone_verified                                          Boolean?                   @default(false)
  avatar_public_id                                        String?                    @db.VarChar(255)
  avatar_url                                              String?                    @db.VarChar(500)
  last_login                                              DateTime?                  @db.Timestamp(0)
  created_at                                              DateTime                   @default(now()) @db.Timestamp(0)
  updated_at                                              DateTime                   @default(now()) @db.Timestamp(0)
  book_orders                                             book_orders[]
  book_submissions                                        book_submissions[]
  deliveries                                              deliveries[]
  email_verification_codes                                email_verification_codes[]
  exchange_chat                                           exchange_chat[]
  exchange_delivery                                       exchange_delivery[]
  exchange_requests_exchange_requests_receiver_idTousers  exchange_requests[]        @relation("exchange_requests_receiver_idTousers")
  exchange_requests_exchange_requests_requester_idTousers exchange_requests[]        @relation("exchange_requests_requester_idTousers")
  favorites                                               favorites[]
  messages_messages_receiver_idTousers                    messages[]                 @relation("messages_receiver_idTousers")
  messages_messages_sender_idTousers                      messages[]                 @relation("messages_sender_idTousers")
  password_reset_codes                                    password_reset_codes[]
  user_achat                                              user_achat[]
  user_addresses                                          user_addresses[]
  user_books                                              user_books[]
  user_books_to_sell                                      user_books_to_sell[]
  user_commandes                                          user_commandes[]
  roles                                                   roles                      @relation(fields: [role_id], references: [id], map: "fk_users_role")
  wallet_recharge_requests                                wallet_recharge_requests[]
  wallets                                                 wallets?

  @@index([role_id], map: "fk_users_role")
}

model wallet_recharge_requests {
  id               BigInt                           @id @default(autoincrement()) @db.UnsignedBigInt
  wallet_id        BigInt                           @db.UnsignedBigInt
  amount           Decimal                          @db.Decimal(10, 2)
  proof_image_url  String                           @db.VarChar(500)
  proof_public_id  String                           @db.VarChar(255)
  status           wallet_recharge_requests_status? @default(pending)
  admin_id         BigInt?                          @db.UnsignedBigInt
  rejection_reason String?                          @db.Text
  created_at       DateTime                         @default(now()) @db.Timestamp(0)
  validated_at     DateTime?                        @db.Timestamp(0)
  users            users?                           @relation(fields: [admin_id], references: [id], onUpdate: Restrict, map: "fk_recharge_admin")
  wallets          wallets                          @relation(fields: [wallet_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_recharge_wallet")

  @@index([admin_id], map: "fk_recharge_admin")
  @@index([wallet_id], map: "fk_recharge_wallet")
}

model wallet_transactions {
  id               BigInt                               @id @default(autoincrement()) @db.UnsignedBigInt
  wallet_id        BigInt                               @db.UnsignedBigInt
  transaction_type wallet_transactions_transaction_type
  amount           Decimal                              @db.Decimal(10, 2)
  balance_before   Decimal                              @db.Decimal(10, 2)
  balance_after    Decimal                              @db.Decimal(10, 2)
  description      String?                              @db.Text
  reference        String?                              @db.VarChar(100)
  created_at       DateTime                             @default(now()) @db.Timestamp(0)
  wallets          wallets                              @relation(fields: [wallet_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_transaction_wallet")

  @@index([wallet_id], map: "fk_transaction_wallet")
}

model wallets {
  id                       BigInt                     @id @default(autoincrement()) @db.UnsignedBigInt
  user_id                  BigInt                     @unique(map: "user_id") @db.UnsignedBigInt
  balance                  Decimal                    @default(0.00) @db.Decimal(10, 2)
  currency                 String                     @default("MAD") @db.Char(3)
  status                   wallets_status?            @default(active)
  created_at               DateTime                   @default(now()) @db.Timestamp(0)
  updated_at               DateTime                   @default(now()) @db.Timestamp(0)
  wallet_recharge_requests wallet_recharge_requests[]
  wallet_transactions      wallet_transactions[]
  users                    users                      @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_wallet_user")

  @@index([status], map: "idx_wallet_status")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model book_submissions {
  id                     BigInt                            @id @default(autoincrement()) @db.UnsignedBigInt
  user_id                BigInt                            @db.UnsignedBigInt
  book_catalog_id        BigInt?                           @db.UnsignedBigInt
  book_condition         book_submissions_book_condition
  estimated_price        Decimal?                          @db.Decimal(10, 2)
  price                  Decimal?                          @db.Decimal(10, 2)
  isbn                   String?                           @db.VarChar(20)
  title                  String                            @db.VarChar(255)
  subtitle               String?                           @db.VarChar(255)
  author                 String                            @db.VarChar(255)
  publisher              String?                           @db.VarChar(255)
  edition                String?                           @db.VarChar(100)
  publication_year       Int?                              @db.Year
  language               String?                           @db.VarChar(100)
  category               String?                           @db.VarChar(100)
  book_type              book_submissions_book_type?       @default(physical)
  cover_type             book_submissions_cover_type?      @default(paperback)
  target_audience        book_submissions_target_audience? @default(all)
  pages                  Int?                              @db.UnsignedInt
  pages_color            book_submissions_pages_color?     @default(black_white)
  dimensions             String?                           @db.VarChar(100)
  weight                 Decimal?                          @db.Decimal(6, 2)
  description            String?                           @db.Text
  summary                String?                           @db.Text
  average_rating         Decimal?                          @default(0.00) @db.Decimal(3, 2)
  search_keywords        String?                           @db.Text
  status                 book_submissions_status           @default(pending)
  request_type           book_submissions_request_type
  created_at             DateTime                          @default(now()) @db.Timestamp(0)
  updated_at             DateTime                          @default(now()) @db.Timestamp(0)
  book_submission_images book_submission_images[]
  books_catalog          books_catalog?                    @relation(fields: [book_catalog_id], references: [id], onUpdate: Restrict, map: "fk_book_submissions_catalog")
  users                  users                             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_book_submissions_user")

  @@index([book_catalog_id], map: "fk_book_submissions_catalog")
  @@index([user_id], map: "fk_book_submissions_user")
}

model user_books_to_sell {
  id              BigInt                            @id @default(autoincrement()) @db.UnsignedBigInt
  user_id         BigInt                            @db.UnsignedBigInt
  book_catalog_id BigInt                            @db.UnsignedBigInt
  book_condition  user_books_to_sell_book_condition
  price           Decimal                           @db.Decimal(10, 2)
  status          user_books_to_sell_status         @default(available)
  note            String?                           @db.Text
  created_at      DateTime                          @default(now()) @db.Timestamp(0)
  updated_at      DateTime                          @default(now()) @db.Timestamp(0)
  book_orders     book_orders[]
  favorites       favorites[]
  user_achat      user_achat[]
  books_catalog   books_catalog                     @relation(fields: [book_catalog_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_user_books_to_sell_book")
  users           users                             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_user_books_to_sell_user")

  @@index([book_catalog_id], map: "fk_user_books_to_sell_book")
  @@index([user_id], map: "fk_user_books_to_sell_user")
}

model book_orders {
  id                   BigInt                     @id @default(autoincrement()) @db.UnsignedBigInt
  user_book_to_sell_id BigInt?                    @db.UnsignedBigInt
  shop_inventory_id    BigInt?                    @db.UnsignedBigInt
  user_id              BigInt                     @db.UnsignedBigInt
  quantity             Int                        @default(1) @db.UnsignedInt
  price                Decimal                    @db.Decimal(10, 2)
  delivery_price       Decimal                    @default(0.00) @db.Decimal(10, 2)
  status               book_orders_status         @default(en_cours)
  payment_method       book_orders_payment_method
  created_at           DateTime                   @default(now()) @db.Timestamp(0)
  updated_at           DateTime                   @default(now()) @db.Timestamp(0)
  shop_inventory       shop_inventory?            @relation(fields: [shop_inventory_id], references: [id], onUpdate: Restrict, map: "fk_book_orders_shop_inventory")
  users                users                      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_book_orders_user")
  user_books_to_sell   user_books_to_sell?        @relation(fields: [user_book_to_sell_id], references: [id], onUpdate: Restrict, map: "fk_book_orders_user_book")
  deliveries           deliveries[]

  @@index([shop_inventory_id], map: "fk_book_orders_shop_inventory")
  @@index([user_id], map: "fk_book_orders_user")
  @@index([user_book_to_sell_id], map: "fk_book_orders_user_book")
}

model deliveries {
  id                   BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  delivery_person_id   BigInt             @db.UnsignedBigInt
  book_order_id        BigInt?            @db.UnsignedBigInt
  user_commande_id     BigInt?            @db.UnsignedBigInt
  exchange_delivery_id BigInt?            @db.UnsignedBigInt
  status               deliveries_status  @default(en_cours)
  total                Decimal            @default(0.00) @db.Decimal(10, 2)
  payment              deliveries_payment @default(wallet)
  created_at           DateTime           @default(now()) @db.Timestamp(0)
  updated_at           DateTime           @default(now()) @db.Timestamp(0)
  book_orders          book_orders?       @relation(fields: [book_order_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_deliveries_book_order")
  users                users              @relation(fields: [delivery_person_id], references: [id], onUpdate: Restrict, map: "fk_deliveries_delivery_person")
  exchange_delivery    exchange_delivery? @relation(fields: [exchange_delivery_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_deliveries_exchange")
  user_commandes       user_commandes?    @relation(fields: [user_commande_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_deliveries_user_commande")

  @@index([delivery_person_id], map: "fk_deliveries_delivery_person")
  @@index([book_order_id], map: "idx_delivery_book_order")
  @@index([exchange_delivery_id], map: "idx_delivery_exchange")
  @@index([user_commande_id], map: "idx_delivery_user_commande")
}

model messages {
  id                                BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  sender_id                         BigInt   @db.UnsignedBigInt
  receiver_id                       BigInt   @db.UnsignedBigInt
  message                           String?  @db.Text
  image_url                         String?  @db.VarChar(500)
  image_public_id                   String?  @db.VarChar(255)
  is_read                           Boolean  @default(false)
  created_at                        DateTime @default(now()) @db.Timestamp(0)
  updated_at                        DateTime @default(now()) @db.Timestamp(0)
  users_messages_receiver_idTousers users    @relation("messages_receiver_idTousers", fields: [receiver_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_messages_receiver")
  users_messages_sender_idTousers   users    @relation("messages_sender_idTousers", fields: [sender_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_messages_sender")

  @@index([receiver_id], map: "fk_messages_receiver")
  @@index([sender_id], map: "fk_messages_sender")
}

model favorites {
  id                    BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  uuid                  String              @default(dbgenerated("(uuid())")) @db.Char(36)
  user_id               BigInt              @db.UnsignedBigInt
  user_book_id          BigInt?             @db.UnsignedBigInt
  user_books_to_sell_id BigInt?             @db.UnsignedBigInt
  shop_inventory_id     BigInt?             @db.UnsignedBigInt
  created_at            DateTime            @default(now()) @db.Timestamp(0)
  shop_inventory        shop_inventory?     @relation(fields: [shop_inventory_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_favorites_shop_inventory")
  users                 users               @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_favorites_user")
  user_books            user_books?         @relation(fields: [user_book_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_favorites_user_book")
  user_books_to_sell    user_books_to_sell? @relation(fields: [user_books_to_sell_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_favorites_user_book_to_sell")

  @@unique([user_id, user_book_id], map: "uq_favorite_exchange")
  @@unique([user_id, user_books_to_sell_id], map: "uq_favorite_sell")
  @@unique([user_id, shop_inventory_id], map: "uq_favorite_shop")
  @@index([shop_inventory_id], map: "idx_favorites_shop_inventory")
  @@index([user_id], map: "idx_favorites_user")
  @@index([user_book_id], map: "idx_favorites_user_book")
  @@index([user_books_to_sell_id], map: "idx_favorites_user_books_to_sell")
}

model user_achat {
  id                   BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  user_id              BigInt              @db.UnsignedBigInt
  shop_inventory_id    BigInt?             @db.UnsignedBigInt
  user_book_to_sell_id BigInt?             @db.UnsignedBigInt
  quantity             Int                 @default(1) @db.UnsignedInt
  unit_price           Decimal             @db.Decimal(10, 2)
  created_at           DateTime            @default(now()) @db.Timestamp(0)
  shop_inventory       shop_inventory?     @relation(fields: [shop_inventory_id], references: [id], onUpdate: Restrict, map: "fk_user_achat_shop_inventory")
  users                users               @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_user_achat_user")
  user_books_to_sell   user_books_to_sell? @relation(fields: [user_book_to_sell_id], references: [id], onUpdate: Restrict, map: "fk_user_achat_user_book")

  @@index([shop_inventory_id], map: "fk_user_achat_shop_inventory")
  @@index([user_id], map: "fk_user_achat_user")
  @@index([user_book_to_sell_id], map: "fk_user_achat_user_book")
}

model user_commandes {
  id             BigInt                        @id @default(autoincrement()) @db.UnsignedBigInt
  user_id        BigInt                        @db.UnsignedBigInt
  achats_json    String                        @db.LongText
  delivery_price Decimal                       @default(0.00) @db.Decimal(10, 2)
  total_price    Decimal                       @db.Decimal(10, 2)
  payment_type   user_commandes_payment_type   @default(wallet)
  payment_status user_commandes_payment_status @default(pending)
  order_status   user_commandes_order_status   @default(pending)
  created_at     DateTime                      @default(now()) @db.Timestamp(0)
  updated_at     DateTime                      @default(now()) @db.Timestamp(0)
  deliveries     deliveries[]
  users          users                         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_user_commandes_user")

  @@index([user_id], map: "fk_user_commandes_user")
}

model password_reset_codes {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  user_id    BigInt   @db.UnsignedBigInt
  code       String   @db.Char(6)
  email      String   @db.VarChar(255)
  expires_at DateTime @default(now()) @db.Timestamp(0)
  used       Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamp(0)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_password_reset_user")

  @@index([user_id], map: "idx_password_reset_user")
  @@index([email, code], map: "idx_password_reset_email_code")
}

model email_verification_codes {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  user_id    BigInt   @db.UnsignedBigInt
  code       String   @db.Char(6)
  email      String   @db.VarChar(255)
  expires_at DateTime @default(now()) @db.Timestamp(0)
  used       Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamp(0)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_email_verification_user")

  @@index([user_id], map: "idx_email_verification_user")
  @@index([email, code], map: "idx_email_verification_email_code")
}

